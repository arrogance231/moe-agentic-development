    "top_k": 2,
    "hidden_size": 2048,
    "num_layers": 24,
    "capacity_factor": 1.25,
    "expert_intermediate_size": 8192,
    "total_params": "~7.1B (8 experts/layer; ~1B dense-equivalent, ~2.3B active/token)",
    "router": "noisy top-k gating, load-balancing aux loss 0.01"
  },
  "parallelism": {
    "data_parallel": 4,
    "expert_parallel": 8,
    "tensor_parallel": 1
