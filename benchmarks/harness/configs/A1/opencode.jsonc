{
  "$schema": "https://opencode.ai/config.json",
  "tools": {"bash": false, "webfetch": false, "edit": false, "write": false, "task": false, "patch": false},
  "permission": {"bash": "deny", "edit": "deny", "webfetch": "deny"},
  "mcp": {
    "moe-bench-search": {
      "type": "local",
      "command": ["/root/moe-agentic-development/.venv/bin/python","/root/moe-agentic-development/benchmarks/harness/search_mcp_server.py"],
      "enabled": true
    }
  }
}
